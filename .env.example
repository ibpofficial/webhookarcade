# Webhook Arcade Environment Configuration

# Server Ports
PORT=4000
HOST=0.0.0.0
WEB_PORT=5173

# Base URLs
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_INGEST_URL=http://localhost:4000/ingest

# Database
# Default: PostgreSQL. (For zero-dependency local dev/tests, file-backed SQLite is also supported)
DATABASE_URL=postgresql://arcade:arcade_secret@localhost:5432/webhook_arcade?schema=public

# Redis & Queues
# BullMQ queue connection string (falls back to synchronous in-memory worker if unset in dev)
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SSRF Protection Policy
# Setting to "true" allows dispatching replays and chaos tests to localhost/127.0.0.1 (Used for CLI forwarding and local tests)
# MUST BE "false" in multi-tenant hosted production environments!
ALLOW_LOCALHOST_TARGETS=false

# Ingestion Limits
MAX_PAYLOAD_SIZE_BYTES=5242880 # 5 MB
DEFAULT_EVENT_RETENTION_HOURS=72


generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  workspaces   Workspace[]

  @@map("users")
}

model Workspace {
  id            String         @id @default(uuid())
  name          String
  ownerId       String?        @map("owner_id")
  isGuest       Boolean        @default(false) @map("is_guest")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  endpoints     Endpoint[]
  guestSessions GuestSession[]
  scenarios     Scenario[]
  testRuns      TestRun[]
  auditLogs     AuditLog[]
  templates     Template[]

  @@map("workspaces")
}

model GuestSession {
  id          String    @id @default(uuid())
  tokenHash   String    @unique @map("token_hash")
  clientName  String    @default("Web Guest") @map("client_name")
  workspaceId String    @map("workspace_id")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("guest_sessions")
}

model Endpoint {
  id               String        @id @default(uuid())
  workspaceId      String        @map("workspace_id")
  tokenHash        String        @unique @map("token_hash")
  tokenPrefix      String        @map("token_prefix")
  name             String
  description      String?
  signingSecretEnc String?       @map("signing_secret_enc")
  isPaused         Boolean       @default(false) @map("is_paused")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responseRule     ResponseRule?
  events           Event[]

  @@index([workspaceId])
  @@index([tokenHash])
  @@map("endpoints")
}

model ResponseRule {
  id               String   @id @default(uuid())
  endpointId       String   @unique @map("endpoint_id")
  statusCode       Int      @default(200) @map("status_code")
  contentType      String   @default("application/json") @map("content_type")
  body             String   @default("{\"received\": true}")
  headersJson      String   @default("{}") @map("headers_json")
  delayMs          Int      @default(0) @map("delay_ms")
  rateLimitPerMin  Int      @default(600) @map("rate_limit_per_min")
  updatedAt        DateTime @updatedAt @map("updated_at")
  endpoint         Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@map("response_rules")
}

model Event {
  id              String      @id @default(uuid())
  endpointId      String      @map("endpoint_id")
  method          String
  path            String
  queryJson       String      @default("{}") @map("query_json")
  headersJson     String      @map("headers_json")
  rawBody         Bytes       @map("raw_body")
  parsedBody      String?     @map("parsed_body")
  statusCode      Int         @default(200) @map("status_code")
  ip              String      @default("127.0.0.1")
  sizeBytes       Int         @default(0) @map("size_bytes")
  isInvalidJson   Boolean     @default(false) @map("is_invalid_json")
  redactedHeaders String      @default("[]") @map("redacted_headers")
  receivedAt      DateTime    @default(now()) @map("received_at")
  endpoint        Endpoint    @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveries      Delivery[]
  replayJobs      ReplayJob[]

  @@index([endpointId, receivedAt])
  @@index([receivedAt])
  @@map("events")
}

model Delivery {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  destinationUrl String   @map("destination_url")
  method         String   @default("POST")
  statusCode     Int      @map("status_code")
  latencyMs      Int      @map("latency_ms")
  headersJson    String   @default("{}") @map("headers_json")
  responseBody   String   @default("") @map("response_body")
  success        Boolean  @default(true)
  errorMessage   String?  @map("error_message")
  sentAt         DateTime @default(now()) @map("sent_at")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("deliveries")
}

model ReplayJob {
  id              String    @id @default(uuid())
  originalEventId String    @map("original_event_id")
  destinationUrl  String    @map("destination_url")
  status          String    @default("completed")
  resultDiff      String?   @map("result_diff")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  originalEvent   Event     @relation(fields: [originalEventId], references: [id], onDelete: Cascade)

  @@index([originalEventId])
  @@map("replay_jobs")
}

model Scenario {
  id              String     @id @default(uuid())
  workspaceId     String     @map("workspace_id")
  name            String
  description     String?
  destinationUrl  String     @map("destination_url")
  basePayload     String     @default("{}") @map("base_payload")
  baseHeadersJson String     @default("{}") @map("base_headers_json")
  stepsJson       String     @map("steps_json")
  assertionsJson  String     @map("assertions_json")
  rngSeed         Int?       @map("rng_seed")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testRuns        TestRun[]

  @@index([workspaceId])
  @@map("scenarios")
}

model TestRun {
  id                   String       @id @default(uuid())
  scenarioId           String       @map("scenario_id")
  workspaceId          String       @map("workspace_id")
  startedAt            DateTime     @default(now()) @map("started_at")
  finishedAt           DateTime     @default(now()) @map("finished_at")
  durationMs           Int          @map("duration_ms")
  totalDeliveries      Int          @map("total_deliveries")
  successfulDeliveries Int          @map("successful_deliveries")
  failedDeliveries     Int          @map("failed_deliveries")
  latencyMin           Int          @map("latency_min")
  latencyAvg           Int          @map("latency_avg")
  latencyP95           Int          @map("latency_p95")
  latencyMax           Int          @map("latency_max")
  allPassed            Boolean      @map("all_passed")
  reportJson           String       @map("report_json")
  scenario             Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testResults          TestResult[]

  @@index([workspaceId])
  @@index([scenarioId])
  @@map("test_runs")
}

model TestResult {
  id            String   @id @default(uuid())
  testRunId     String   @map("test_run_id")
  assertionId   String   @map("assertion_id")
  assertionType String   @map("assertion_type")
  description   String
  passed        Boolean
  expected      String?
  actual        String?
  errorMessage  String?  @map("error_message")
  testRun       TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([testRunId])
  @@map("test_results")
}

model Template {
  id                 String     @id @default(uuid())
  name               String
  category           String
  provider           String
  description        String
  method             String     @default("POST")
  defaultHeadersJson String     @map("default_headers_json")
  payload            String
  isBuiltIn          Boolean    @default(false) @map("is_built_in")
  workspaceId        String?    @map("workspace_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("templates")
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  actorId     String    @map("actor_id")
  actorType   String    @default("guest") @map("actor_type")
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  detailsJson String    @default("{}") @map("details_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

